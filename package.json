{
  "name": "angular-ionic-capacitor-app-with-relational-storage",
  "version": "0.0.1",
  "author": "Himanshu Sukhpal",
  "homepage": "https://ionicframework.com/",
  "type": "module",
  "browser": {
    "fs": false,
    "path": false,
    "crypto": false
  },
  "scripts": {
    "postinstall": "copyfiles -u 3 ./node_modules/sql.js/dist/sql-wasm.wasm ./src/assets && npx tsx ./scripts/modify-typeorm.js",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "resources": "cordova-res ios && cordova-res android && node scripts/resources.cjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/status-bar": "8.0.4",
    "@capawesome/capacitor-android-edge-to-edge-support": "^8.0.8",
    "@ionic/angular": "^9.0.0",
    "copyfiles": "^2.4.1",
    "ionicons": "^8.1.0",
    "joi": "^18.3.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/language-service": "^22.2.4",
    "@capacitor/cli": "8.6.0",
    "@ionic/angular-toolkit": "^13.0.0",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "typescript": "~6.0.3"
  },
  "description": "An Ionic capacitor sqlite typeorm project"
}
