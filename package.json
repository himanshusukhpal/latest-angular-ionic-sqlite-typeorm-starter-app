    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "resources": "cordova-res ios && cordova-res android && node scripts/resources.cjs"
  },
  "private": true,
  "dependencies": {
